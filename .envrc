use flake

# The flake shellHook exports ELAN_TOOLCHAIN from this file, but nix-direnv
# only watches flake.nix and flake.lock; without this, a toolchain bump leaves
# cached shells exporting the previous release.
watch_file lean-toolchain

# Machine-local shared Lake artifact cache; absent for other contributors,
# in which case Lake falls back to its default cache location.
if [ -f ../lean-builder/env.sh ]; then
  watch_file ../lean-builder/env.sh
  source ../lean-builder/env.sh
fi
